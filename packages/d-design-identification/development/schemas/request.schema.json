{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d-design.local/schemas/extreme-request-v1.json",
  "title": "D-Design extreme identification request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canvas",
    "preset",
    "title"
  ],
  "properties": {
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "unit"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "px",
            "mm"
          ]
        }
      }
    },
    "preset": {
      "enum": [
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "structure": {
      "const": "brand-pillar"
    },
    "brandVariant": {
      "enum": [
        "horizontal",
        "vertical",
        "logo-top",
        "logo-bottom"
      ]
    },
    "informationPlacement": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom"
      ]
    },
    "qrEnabled": {
      "const": false
    },
    "qr": {
      "type": "null"
    },
    "partners": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "visibleAspect",
          "heightInBrandUnits"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "visibleAspect": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "heightInBrandUnits": {
            "type": "number",
            "minimum": 0.8,
            "maximum": 1.2
          }
        }
      }
    }
  },
  "$comment": "Grapheme counts, orientation-specific enums, fixed ratios, missing glyphs and rendered geometry are enforced by runtime/extreme.mjs, not by JSON string length."
}
