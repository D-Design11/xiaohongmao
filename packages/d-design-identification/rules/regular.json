      "copy-change"
    ],
    "brand_unit": "H=visible smile-symbol height",
    "pixel_to_point": "pt=px*72/output_DPI",
    "text_capacity_calculation": "max(ceil(title_max(12)/candidate_title_lines(2))*title_em(200), subtitle_line_limit(10)*subtitle_em(100))=1200",
    "text_capacity_note": "M预先为主标题12字/候选2行及副标题每行10字预留；按尺寸计算，不按当前文案临时缩字。字号参数仍为候选值。"
